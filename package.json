{
  "name": "ujimu",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "predev": "npm run skills:sync",
    "dev": "TMPDIR=/tmp nuxt dev --host 127.0.0.1 --port 3000",
    "prebuild": "npm run skills:sync",
    "build": "nuxt build",
    "pretest": "npm run skills:sync",
    "test": "vitest run",
    "pretypecheck": "npm run skills:sync",
    "typecheck": "nuxt typecheck",
    "skills:sync": "node scripts/sync-llm-wiki.mjs --if-missing",
    "skills:update": "node scripts/sync-llm-wiki.mjs --force"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@nuxt/ui": "^4.10.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "nuxt": "^4.5.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "vue": "^3.5.41",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.124",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "esbuild": "0.28.1",
