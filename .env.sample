# Runtime mode used by Nuxt/Nitro and server utilities.
# Development normally uses "development"; production deploys should set "production".
# This affects secure cookies, passkey defaults, fake OTP delivery, and console logging.
NODE_ENV=development

# Operating-system command search path.
# The PDF conversion smoke path needs "gemini" and "timeout" to be discoverable on PATH.
# Usually this is supplied by the shell/container; avoid overriding it unless necessary.
# If you do override it, preserve the system path entries.
# PATH=

# Root directory for persistent Ujimu data.
# SQLite, specialties, trash, ingestion state, and operational logs live below this directory.
# Default in code is ~/.local/share/ujimu.
UJIMU_DATA_DIR=~/.local/share/ujimu

# Optional explicit SQLite database path.
# If omitted, Ujimu stores SQLite at $UJIMU_DATA_DIR/db/ujimu.sqlite.
# The app supports the literal $UJIMU_DATA_DIR prefix in this value.
UJIMU_DB_PATH=$UJIMU_DATA_DIR/db/ujimu.sqlite

# Public application name exposed through Nuxt runtime config.
# This is safe for the browser and defaults to "Ujimu".
NUXT_PUBLIC_APP_NAME=Ujimu

# Secret used to sign session JWT cookies.
# Strongly recommended in all persistent environments; if omitted, sessions use a random in-memory secret.
# In-memory sessions are invalidated on every process restart.
UJIMU_SESSION_SECRET=

# Pepper used when hashing OTP codes before storage.
# Strongly recommended in all persistent environments; if omitted, pending OTPs use a random in-memory pepper.
# In-memory OTP challenges are invalidated on every process restart.
UJIMU_OTP_PEPPER=

# Enables fake OTP delivery for local development only.
# The implementation refuses fake delivery in production.
# Tests normally inject providers directly instead of relying on this flag.
UJIMU_AUTH_FAKE_DELIVERY_ENABLED=false

# Comma-separated allowlist of verified contacts that receive the single admin role.
# Emails are compared lowercased; phone numbers are compared without spaces.
# If empty or unset, nobody is an admin.
UJIMU_ADMIN_CONTACTS=

# Weekly request quota for subscribed users.
# Subscribed users have no daily limit, but this weekly limit still applies.
# Default in code is 5000.
UJIMU_SUBSCRIBED_WEEKLY_LIMIT=5000

# Allows passkey rate-limiting code to trust x-real-ip and x-forwarded-for headers.
# Set to true only when the app is behind a trusted proxy that sanitizes those headers.
# Leave false for direct deployments or untrusted proxy chains.
UJIMU_TRUST_PROXY_HEADERS=false

# Shared secret required by billing webhook endpoints.
# Without it, webhook confirmation returns 503 and subscriptions are not activated.
# Store the real value in a secret manager or uncommitted environment file.
UJIMU_BILLING_WEBHOOK_SECRET=

# Enables passkey registration and login endpoints/UI.
# Passkeys are disabled unless this is exactly "true".
# OTP remains the bootstrap and recovery path.
UJIMU_PASSKEYS_ENABLED=false

# WebAuthn relying-party ID.
# Required in production when passkeys are enabled.
# Development defaults to localhost if this is omitted.
UJIMU_PASSKEY_RP_ID=localhost

# WebAuthn relying-party display name.
# Required in production when passkeys are enabled.
# Development defaults to Ujimu if this is omitted.
UJIMU_PASSKEY_RP_NAME=Ujimu

# Exact browser origin accepted for WebAuthn verification.
# Required in production when passkeys are enabled.
# Development defaults to http://localhost:3000 if this is omitted.
UJIMU_PASSKEY_ORIGIN=http://localhost:3000

# Directory containing Ujimu-owned Pi configuration, skills, tools, and auth sample.
# Defaults to config/ujimu-pi-agent; repository .pi/ is reserved for developer-local Pi state.
# Use an override only when mounting a secret-managed Pi agent directory.
UJIMU_PI_AGENT_DIR=config/ujimu-pi-agent

# Enables the admin-triggered Pi conversion stage.
# When false or unset, uploaded raw sources remain pending and no conversion session is started.
UJIMU_PI_CONVERSION_ENABLED=false

# Enables the admin-triggered Pi ingestion stage.
# When false or unset, converted Markdown sources remain pending and no ingestion session is started.
UJIMU_PI_INGESTION_ENABLED=false

# Enables real user consultation through the Pi chat runner.
# When false or unset, chat uses the safe service-unavailable fallback instead of starting Pi.
UJIMU_PI_CHAT_ENABLED=false

# Optional Pi provider override for the conversion agent.
# Must be set together with UJIMU_PI_CONVERSION_MODEL; otherwise startup/session creation fails clearly.
# If both are empty, conversion uses config/ujimu-pi-agent/settings.json defaults.
UJIMU_PI_CONVERSION_PROVIDER=

# Optional Pi model override for the conversion agent.
# Must be set together with UJIMU_PI_CONVERSION_PROVIDER.
# The selected model must exist and have configured authentication.
UJIMU_PI_CONVERSION_MODEL=

# Optional Pi provider override for the ingestion agent.
# Must be set together with UJIMU_PI_INGESTION_MODEL; otherwise startup/session creation fails clearly.
# If both are empty, ingestion uses config/ujimu-pi-agent/settings.json defaults.
UJIMU_PI_INGESTION_PROVIDER=

# Optional Pi model override for the ingestion agent.
# Must be set together with UJIMU_PI_INGESTION_PROVIDER.
# The selected model must exist and have configured authentication.
UJIMU_PI_INGESTION_MODEL=

# Maximum allowed size, in bytes, for generated Markdown after conversion.
# If conversion output is larger, conversion fails and ingestion remains blocked.
# Default in code is 1048576 bytes, or 1 MiB.
UJIMU_PI_CONVERSION_MAX_MARKDOWN_BYTES=1048576

# Retry age, in minutes, for stale conversion or ingestion records stuck in processing.
# Records older than this are eligible for retry.
# Default in code is 30 minutes.
UJIMU_PI_PIPELINE_STALE_PROCESSING_MINUTES=30

# Enables sanitized Pi session debug logging.
# Keep false by default; use only while diagnosing Pi sessions.
# Debug payloads are sanitized but may still reveal operational structure.
UJIMU_PI_DEBUG_ENABLED=false

# Gemini API key used by the Gemini CLI PDF-to-Markdown tool.
# Required only when real PDF conversion through pdf_to_markdown is enabled.
# Never commit a real key or place it in versioned Pi settings/prompts.
GEMINI_API_KEY=

# OpenRouter key referenced by config/ujimu-pi-agent/auth.json.sample.
# Ujimu does not read this variable directly; Pi resolves it through its auth configuration.
# Required when the selected Pi provider is openrouter.
OPENROUTER_API_KEY=

# OpenAI key referenced by config/ujimu-pi-agent/auth.json.sample.
# Ujimu does not read this variable directly; Pi resolves it through its auth configuration.
# Required only when the selected Pi provider/model uses OpenAI.
OPENAI_API_KEY=

# Anthropic key referenced by config/ujimu-pi-agent/auth.json.sample.
# Ujimu does not read this variable directly; Pi resolves it through its auth configuration.
# Required only when the selected Pi provider/model uses Anthropic.
ANTHROPIC_API_KEY=

# Legacy Slice 13 planning key for conversion thinking level.
# Current runtime does not read this variable, so it is effectively obsolete/no-op.
# Keep thinking defaults in config/ujimu-pi-agent/settings.json unless a future slice implements this override.
UJIMU_PI_CONVERSION_THINKING_LEVEL=

# Legacy Slice 13 planning key for ingestion thinking level.
# Current runtime does not read this variable, so it is effectively obsolete/no-op.
# Keep thinking defaults in config/ujimu-pi-agent/settings.json unless a future slice implements this override.
UJIMU_PI_INGESTION_THINKING_LEVEL=
