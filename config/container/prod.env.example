# Ujimu production container environment example.
# Copy to config/container/prod.env or set UJIMU_ENV_FILE to a secure external path.
# Do not commit real secrets.

NODE_ENV=production
TZ=Africa/Luanda
HOST=0.0.0.0
PORT=3000

UJIMU_DATA_DIR=/home/ujimu/.local/share/ujimu
UJIMU_DB_PATH=/home/ujimu/.local/share/ujimu/db/ujimu.sqlite
UJIMU_CONFIG_DIR=/home/ujimu/.config/ujimu
UJIMU_PI_BUNDLE_DIR=/app/config/pi

# Host paths consumed by scripts/container/*.sh, not by the app inside the container.
UJIMU_HOST_PI_DIR=/srv/ujimu/prod/pi
UJIMU_HOST_DATA_DIR=/srv/ujimu/prod/data

UJIMU_PI_CONVERSION_ENABLED=true
UJIMU_PI_INGESTION_ENABLED=true
UJIMU_PI_CHAT_ENABLED=true

# Required production secrets/configuration. Fill outside source control.
UJIMU_SESSION_SECRET=
UJIMU_OTP_PEPPER=
UJIMU_BILLING_WEBHOOK_SECRET=
UJIMU_ADMIN_CONTACTS=
GEMINI_API_KEY=

# Optional production configuration.
UJIMU_PASSKEYS_ENABLED=false
UJIMU_PASSKEY_RP_ID=
UJIMU_PASSKEY_RP_NAME=Ujimu
UJIMU_PASSKEY_ORIGIN=
UJIMU_SUBSCRIBED_WEEKLY_LIMIT=5000
