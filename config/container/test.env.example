# Ujimu test container environment example.
# Copy to config/container/test.env or set UJIMU_ENV_FILE to a secure external path.
# Test mode uses existing mock/no-op auth/payment/communication paths, while Pi/Gemini flows may run.

NODE_ENV=development
TZ=Africa/Luanda
HOST=0.0.0.0
PORT=3000

UJIMU_DATA_DIR=/home/ujimu/.local/share/ujimu
UJIMU_DB_PATH=/home/ujimu/.local/share/ujimu/db/ujimu.sqlite
UJIMU_PI_AGENT_DIR=/app/config/ujimu-pi-agent

# Host paths consumed by scripts/container/*.sh, not by the app inside the container.
UJIMU_HOST_PI_DIR=/srv/ujimu/test/pi
UJIMU_HOST_DATA_DIR=/srv/ujimu/test/data

UJIMU_PI_CONVERSION_ENABLED=true
UJIMU_PI_INGESTION_ENABLED=true
UJIMU_PI_CHAT_ENABLED=true

UJIMU_AUTH_FAKE_DELIVERY_ENABLED=true
UJIMU_BILLING_WEBHOOK_SECRET=test-billing-webhook-secret
UJIMU_ADMIN_CONTACTS=admin@example.com
UJIMU_SESSION_SECRET=test-session-secret-change-me
UJIMU_OTP_PEPPER=test-otp-pepper-change-me
GEMINI_API_KEY=

UJIMU_PASSKEYS_ENABLED=false
UJIMU_SUBSCRIBED_WEEKLY_LIMIT=5000
